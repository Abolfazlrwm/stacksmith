{
  "title": "Stacksmith — SLO and error budget",
  "uid": "stacksmith-slo",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {"from": "now-7d", "to": "now"},
  "tags": ["stacksmith", "slo"],
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "title": "Availability (99.5% SLO, 30d)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
      "targets": [{"expr": "slo:availability_30d", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.99},
              {"color": "green", "value": 0.995}
            ]
          }
        }
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 2,
      "title": "Error budget used (0 = full, 1 = empty)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 0},
      "targets": [{"expr": "slo:error_budget_used_ratio", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.7},
              {"color": "red", "value": 0.95}
            ]
          }
        }
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 3,
      "title": "Request rate (req/s, nginx-exporter)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 0},
      "targets": [{"expr": "nginx:request_rate_5m", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {"steps": [{"color": "green"}, {"color": "yellow", "value": 100}]}
        }
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 4,
      "title": "Availability probe (5m average)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "targets": [
        {
          "expr": "slo:availability_5m",
          "refId": "A",
          "legendFormat": "probe success"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {"steps": [{"color": "red"}, {"color": "green", "value": 0.995}]}
        }
      }
    },
    {
      "id": 5,
      "title": "Request rate through nginx (5m)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "targets": [
        {
          "expr": "nginx:request_rate_5m",
          "refId": "A",
          "legendFormat": "req/s"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 6,
      "title": "nginx connections (active/reading/writing/waiting)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 14},
      "targets": [
        {"expr": "nginx_connections_active", "refId": "active", "legendFormat": "active"},
        {"expr": "nginx_connections_reading", "refId": "reading", "legendFormat": "reading"},
        {"expr": "nginx_connections_writing", "refId": "writing", "legendFormat": "writing"},
        {"expr": "nginx_connections_waiting", "refId": "waiting", "legendFormat": "waiting"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"drawStyle": "line", "lineInterpolation": "smooth"}
        }
      }
    }
  ]
}
