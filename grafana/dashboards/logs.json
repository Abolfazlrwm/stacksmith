{
  "title": "Stacksmith — container logs (Loki)",
  "uid": "stacksmith-logs",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-15m", "to": "now"},
  "tags": ["stacksmith", "logs"],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {"type": "loki", "uid": "Loki"},
        "query": "label_values({project=\"stacksmith\"}, service)",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "level",
        "type": "query",
        "datasource": {"type": "loki", "uid": "Loki"},
        "query": "label_values({project=\"stacksmith\"}, level)",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Log lines (last 15m)",
      "type": "logs",
      "datasource": {"type": "loki", "uid": "Loki"},
      "gridPos": {"h": 16, "w": 24, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "{project=\"stacksmith\", service=~\"$service\", level=~\"$level\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 2,
      "title": "Error count by service (last 15m)",
      "type": "bargauge",
      "datasource": {"type": "loki", "uid": "Loki"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "sum(count_over_time({project=\"stacksmith\", level=\"ERROR\"}[$__range])) by (service)",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    }
  ]
}
