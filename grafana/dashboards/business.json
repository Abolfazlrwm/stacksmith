{
  "title": "Stacksmith — backup & business metrics",
  "uid": "stacksmith-business",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "tags": ["stacksmith"],
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "title": "Backup freshness (hours since last backup)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
      "targets": [{"expr": "(time() - node_textfile_mtime_seconds{file=\"backup.prom\"}) / 3600", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 25}, {"color": "red", "value": 26}]}}}
    },
    {
      "id": 2,
      "title": "Container count",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 0},
      "targets": [{"expr": "count(container_last_seen{name!=\"\"})", "refId": "A"}]
    },
    {
      "id": 3,
      "title": "Uptime (hours)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 0},
      "targets": [{"expr": "time() - process_start_time_seconds{job=\"prometheus\"}", "refId": "A"}]
    },
    {
      "id": 4,
      "title": "Firing alerts",
      "type": "table",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 6},
      "targets": [{"expr": "ALERTS{alertstate=\"firing\"}", "refId": "A", "format": "table", "instant": true}]
    }
  ]
}
