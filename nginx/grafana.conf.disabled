# Grafana reverse proxy with basic auth — enabled by scripts/setup-grafana-auth.sh.
#
# This file is named .disabled so nginx does not auto-load it.
# setup-grafana-auth.sh renames it to grafana.conf (which nginx auto-includes
# from the conf.d directory) after generating the htpasswd file.
#
# To activate manually:
#   bash scripts/setup-grafana-auth.sh <username> <password>
#   mv nginx/grafana.conf.disabled nginx/grafana.conf
#   docker compose exec nginx nginx -s reload

location /grafana/ {
    auth_basic "stacksmith";
    auth_basic_user_file /etc/nginx/conf.d/grafana.htpasswd;
    proxy_pass http://grafana:3000/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_redirect off;
}
