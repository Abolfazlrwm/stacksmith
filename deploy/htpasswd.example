# Example htpasswd for tenant identities in the docubot demo stack.
#
# Mount it into nginx (docker-compose.prod.yml) and enable inside
# nginx/default.conf's `location /`:
#     auth_basic           "docubot tenant";
#     auth_basic_user_file /etc/nginx/htpasswd;
#
# nginx then authenticates the visitor and forwards the verified username
# as X-Docubot-Owner; every unauthenticated request stays on the anonymous
# tenant. Generate real entries with the htpasswd tool from apache2-utils:
#     htpasswd -B deploy/htpasswd.example alice
#
# (placeholder lines below are NOT valid hashes — replace them)
alice:$2y$05$REPLACE_WITH_A_REAL_BCRYPT_HASH
bob:$2y$05$REPLACE_WITH_A_REAL_BCRYPT_HASH
