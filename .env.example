# --- Django ---
# --- Container image (override to pull from GHCR instead of building)
# APP_IMAGE=ghcr.io/abolfazlrwm/stacksmith/app:latest

DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=docubot.example.com,localhost

# --- Postgres ---
POSTGRES_DB=docubot
POSTGRES_USER=docubot
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Celery ---
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Gunicorn ---
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# --- Nginx (host port mapping) ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- Backup encryption (age) ---
# Generate a key with: age-keygen -o age.key
# Put the PUBLIC key (age1...) here for encryption.
BACKUP_AGE_RECIPIENT=age1...
# Path to the PRIVATE key file for decryption (restore).
BACKUP_AGE_IDENTITY=/opt/stacksmith/age.key

# --- Alert routing (Alertmanager) ---
# Leave empty to disable a receiver.
SLACK_WEBHOOK_URL=

# --- Distributed tracing (OpenTelemetry → Tempo) ---
# Leave empty to disable tracing. Set to http://tempo:4318/v1/traces to enable.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
