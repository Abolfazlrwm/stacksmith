# --- Django ---
# --- Container image (override to pull from GHCR instead of building)
# APP_IMAGE=ghcr.io/abolfazlrwm/stacksmith/app:latest

DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=docubot.example.com,localhost

# --- Postgres ---
POSTGRES_DB=docubot
POSTGRES_USER=docubot
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Celery ---
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Gunicorn ---
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# --- Nginx (host port mapping) ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- Backup encryption (age) ---
# Generate a key with: age-keygen -o age.key
# Put the PUBLIC key (age1...) here for encryption.
BACKUP_AGE_RECIPIENT=age1...
# Path to the PRIVATE key file for decryption (restore).
BACKUP_AGE_IDENTITY=/opt/stacksmith/age.key

# --- Alert routing (Alertmanager) ---
# Leave empty to disable a receiver.
SLACK_WEBHOOK_URL=

# --- Distributed tracing (OpenTelemetry → Tempo) ---
# Leave empty to disable tracing. Set to http://tempo:4318/v1/traces to enable.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# --- docubot (v1.2.0) ---
# Where uploaded documents are stored. Mounted into both the API and the
# worker containers; the worker reads here during ingestion.
DOCUBOT_UPLOAD_ROOT=/data/uploads

# Embedding provider:
#   local   (default) — sentence-transformers all-MiniLM-L6-v2 on the VPS.
#                     Documents never leave the host.
#   openai            — OpenAI text-embedding-3-small (requires OPENAI_API_KEY
#                     and a 1536-dim migration — see ADR-0036).
#   stub              — hash-based, for tests and `make demo` only.
DOCUBOT_EMBED_PROVIDER=local

# LLM provider:
#   openai    (default) — gpt-4o-mini. Requires OPENAI_API_KEY.
#   anthropic           — claude-3-5-haiku-latest. Requires ANTHROPIC_API_KEY.
#   ollama              — a local Ollama instance; no outbound traffic.
#                        Set DOCUBOT_OLLAMA_URL (default http://ollama:11434).
#   stub                — deterministic answer, for tests and `make demo`.
DOCUBOT_LLM_PROVIDER=openai
# Override the default model for the chosen provider:
# DOCUBOT_LLM_MODEL=gpt-4o-mini
DOCUBOT_LLM_TEMPERATURE=0.2
DOCUBOT_LLM_MAX_TOKENS=800

# When DOCUBOT_LLM_PROVIDER=openai or DOCUBOT_EMBED_PROVIDER=openai:
# OPENAI_API_KEY=sk-...
# When DOCUBOT_LLM_PROVIDER=anthropic:
# ANTHROPIC_API_KEY=sk-ant-...

# CORS — the single-page chat UI at /app/ is same-origin in prod. Add
# origins here only if you serve the UI from a different host in dev.
DOCUBOT_CORS_ORIGINS=http://localhost:5173
