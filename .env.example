# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=docubot.example.com,localhost

# --- Postgres ---
POSTGRES_DB=docubot
POSTGRES_USER=docubot
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Celery ---
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Gunicorn ---
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# --- Nginx (host port mapping) ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
