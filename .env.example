# ---------------------------------------------------------------------------
# stacksmith environment. Copy to .env and fill in the values:
#
#   cp .env.example .env
#
# Required variables are enforced by scripts/check-env.sh before anything
# comes up. Every value here is commented out on purpose: a commented file
# cannot half-work, an uncommented default can.
# ---------------------------------------------------------------------------

# --- required ---------------------------------------------------------------

# Django SECRET_KEY of the docubot app.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
#SECRET_KEY=

# Postgres password (the only DB credential the stack needs).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
#POSTGRES_PASSWORD=

# App image the app tier runs. Point this at a docubot release, e.g.
#   ghcr.io/abolfazlrwm/docubot:1.4.0
# CI uses a contract-equivalent stub built from tests/stub-app/.
#DOCUBOT_IMAGE=ghcr.io/abolfazlrwm/docubot:latest

# --- database -----------------------------------------------------------------

#POSTGRES_DB=docubot
#POSTGRES_USER=docubot

# --- celery ---------------------------------------------------------------------

# Dotted path of the celery app inside the image (docubot: config, CI stub: stub)
#CELERY_APP=config

# Redis URLs. Broker and cache can share the instance; different logical DBs.
#REDIS_URL=redis://redis:6379/0
#CELERY_BROKER_URL=redis://redis:6379/1

# --- edge -----------------------------------------------------------------------

# Host ports nginx publishes. Defaults are fine on a dedicated VPS.
#NGINX_HTTP_PORT=80
#NGINX_HTTPS_PORT=443

# --- deploy ---------------------------------------------------------------------

# Seconds the previous slot keeps serving after the upstream switch, so
# in-flight requests drain before it goes away.
#GRACE_PERIOD=30

# --- backups --------------------------------------------------------------------

# Where backups are written on the host (default: ./backups in the repo).
#BACKUP_DIR=

# rsync target for the off-host copy, e.g. backup@nas:/srv/backups/stacksmith
# Empty disables the off-host copy (the drill still runs locally).
#BACKUP_RSYNC_TARGET=

# GPG recipient for at-rest encryption of new backups (empty = plain + sha256).
#BACKUP_GPG_RECIPIENT=

# Directory the node-exporter textfile collector reads, so prometheus can
# alert on backup staleness. Empty disables the metric.
#BACKUP_METRICS_DIR=
