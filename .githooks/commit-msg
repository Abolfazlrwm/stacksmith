#!/usr/bin/env bash
# .githooks/commit-msg — local pre-commit-msg hook for stacksmith.
#
# Install with:  git config core.hooksPath .githooks
#
# This runs commitlint on the message you just wrote, so you get the same
# feedback the CI gate gives — before you push.
set -euo pipefail

# Skip in CI — the workflow handles it there.
if [ -n "${CI:-}" ]; then
  exit 0
fi

# Skip for merge commits and amend (the editor already has the old message).
if [ -f .git/MERGE_MSG ] && [ "$1" = ".git/COMMIT_EDITMSG" ]; then
  exit 0
fi

if ! command -v npx >/dev/null 2>&1; then
  echo "[commit-msg] npx not found; skipping local lint (CI will still check)" >&2
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

# Install deps on first run.
if [ ! -d commitlint/node_modules ]; then
  (cd commitlint && npm install --no-fund --no-audit >/dev/null 2>&1) || true
fi

npx --prefix commitlint commitlint --edit "$1" --verbose
