#!/usr/bin/env bash
# deploy-to-vps.sh — SSH into the provisioned VPS and bring up the stack.
# Generated by Terraform from terraform/main.tf.
set -euo pipefail
SERVER_IP="${1:-SERVER_IP_PLACEHOLDER}"
echo "[deploy] SSH to root@$SERVER_IP"
ssh -o StrictHostKeyChecking=accept-new "root@$SERVER_IP" << 'REMOTE'
set -euo pipefail
cd /opt/stacksmith
git pull --ff-only
cp .env.example .env
echo "[deploy] edit .env on the server, then run:"
echo "  cd /opt/stacksmith && make doctor && make up"
REMOTE
